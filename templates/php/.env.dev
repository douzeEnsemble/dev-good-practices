# Environnement de développement (copié en .env.dev.local par `make install`) et valeurs de
# compilation du cache prod (Dockerfile, cible php_prod). Toute clé %env(...)% de config/ y figure.
APP_ENV=dev
APP_SECRET=dev-secret-not-for-production
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=18&charset=utf8"
