<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.4/phpunit.xsd" backupGlobals="false"
  colors="true" bootstrap="tests/bootstrap.php" cacheDirectory=".phpunit.cache"
  controlGarbageCollector="true" numberOfTestsBeforeGarbageCollection="50"
  failOnWarning="true" failOnRisky="true" failOnDeprecation="true">
  <php>
    <ini name="display_errors" value="1" />
    <ini name="error_reporting" value="-1" />
    <ini name="memory_limit" value="-1" />
    <server name="APP_ENV" value="test" force="true" />
    <server name="KERNEL_CLASS" value="App\Kernel" force="true" />
    <server name="SHELL_VERBOSITY" value="-1" />
    <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[self]=0" />
    <!-- Base de test : identifiants de développement uniquement, jamais ceux d'un vrai environnement -->
    <env name="DATABASE_URL"
      value="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=13&amp;charset=utf8"
      force="true" />
  </php>
  <testsuites>
    <testsuite name="Project Test Suite">
      <directory>tests</directory>
      <!-- Les tests navigateur ont leur suite (templates/php-ui) : jamais dans la couverture ni la mutation -->
      <exclude>tests/src/Browser</exclude>
    </testsuite>
  </testsuites>
  <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
    <include>
      <directory suffix=".php">src</directory>
    </include>
  </source>
</phpunit>
